---
import Base from "~/layouts/Base.astro";
import { asc } from "drizzle-orm";
import { db } from "~/lib/db";
import { host } from "@db/schema";

const rows = await db.select().from(host).orderBy(asc(host.hostname));
---
<Base title="Hosts">
  <h2>Hosts</h2>
  <p class="muted">{rows.length} host{rows.length === 1 ? "" : "s"} in inventory.</p>

  {rows.length === 0 ? (
    <p>No hosts yet.</p>
  ) : (
    <table>
      <thead>
        <tr>
          <th>Namespace</th>
          <th>Hostname</th>
          <th>Kind</th>
          <th>Location</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((h) => (
          <tr>
            <td><span class="pill">{h.namespace}</span></td>
            <td><strong>{h.hostname}</strong></td>
            <td>{h.kind}</td>
            <td class="muted">{h.location ?? ""}</td>
            <td class="muted">{h.notes ?? ""}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</Base>
