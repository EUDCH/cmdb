# Copy to .env and fill in. .env is gitignored.

# Postgres credentials — used by docker-compose to seed the container, and
# composed into DATABASE_URL below for the app.
POSTGRES_USER=cmdb
POSTGRES_PASSWORD=cmdb
POSTGRES_DB=cmdb
POSTGRES_PORT=5432

# PostgreSQL connection string used by the Astro app.
# - Host dev (bun run dev on the host):
#       postgresql://cmdb:cmdb@localhost:5432/cmdb
# - Containerised app (docker compose --profile app):
#       the compose file overrides this to use the `postgres` service name.
DATABASE_URL=postgresql://cmdb:cmdb@localhost:5432/cmdb

# Auth mode (see docs/adr/0003-auth.md).
#   dev  — middleware short-circuits, hardcoded dev user, red banner in UI.
#          Use for stack-up testing before OPERAS ID has the client registered.
#   oidc — full OIDC against OPERAS ID. Requires OIDC_* below + SESSION_SECRET.
# Production deployments MUST use oidc.
AUTH_MODE=dev

# OIDC against OPERAS ID (required when AUTH_MODE=oidc).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI must match the app-facing URL + /auth/callback.
# Example: https://cmdb.example.org/auth/callback
OIDC_REDIRECT_URI=

# Random 32+ byte secret for cookie session signing (required for oidc).
# Generate with: openssl rand -base64 48
SESSION_SECRET=
