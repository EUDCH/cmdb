# Copy to .env and fill in. .env is gitignored.

# PostgreSQL connection string.
# Local dev example: postgresql://cmdb:cmdb@localhost:5432/cmdb
DATABASE_URL=

# OIDC against OPERAS ID (see docs/adr/0001-stack.md).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Random 32+ byte secret for cookie session signing.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
