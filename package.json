{
  "name": "cmdb",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "OPERAS / EDCH Configuration Management Database — v1 EDCH-first, v2 OPERAS-broader",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "bun run ./dist/server/entry.mjs",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run db/seed.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.0.0",
    "astro": "^5.1.0",
    "drizzle-orm": "^0.36.4",
    "openid-client": "^6.8.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2"
  }
}
