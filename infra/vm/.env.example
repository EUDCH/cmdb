# Copy to /opt/cmdb/.env on the VM and fill in real values.
# Mode 0600, owned by ubuntu:ubuntu (the user running `docker compose`).
# Never committed; never echoed into shell history.

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Tag pulled from ghcr.io/eudch/cmdb. `deploy.sh` overrides this with the
# argument it receives from the workflow. Keep `main` as the local default
# so a hand-run `docker compose pull` picks up the latest known-good image.
IMAGE_TAG=main

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=cmdb
POSTGRES_PASSWORD=
POSTGRES_DB=cmdb

# DATABASE_URL is consumed by both the app and the one-shot migrate
# container. Hostname is the compose service name on the private bridge.
DATABASE_URL=postgresql://cmdb:CHANGE_ME@postgres:5432/cmdb

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Phase 1 per ADR-0004: dev short-circuit, red banner visible. Phase 2
# flips to `oidc` against OPERAS ID in a separate ADR.
AUTH_MODE=dev

# Cookie session signing key — generate with: openssl rand -base64 48
SESSION_SECRET=

# OIDC values are Phase 2; leave blank for Phase 1.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Public hostname Caddy answers on. Must resolve to this VM's public IP and
# have ports 80 + 443 reachable from the public internet for the HTTP-01
# ACME challenge to succeed.
DOMAIN=cmdb.edch.eu

# Contact email registered with Let's Encrypt for renewal warnings.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# GHCR pull credentials
# ---------------------------------------------------------------------------
# bootstrap.sh logs the deploy user into ghcr.io with these so the VM can
# pull ghcr.io/eudch/cmdb:<tag>. Use a personal-access token scoped to
# `read:packages` only — never a write token. Rotate periodically.
GHCR_USER=
GHCR_TOKEN=
