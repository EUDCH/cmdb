# Caddy v2 — TLS termination + reverse proxy for the CMDB.
#
# DOMAIN and ACME_EMAIL are passed into the container via the compose
# file's `environment:` block (scoped to just these two vars — no
# shared env_file, so app secrets like SESSION_SECRET / GHCR_TOKEN
# never enter the public-facing proxy). The values are interpolated
# from /opt/cmdb/.env at the compose CLI layer.

{
	# ACME contact for Let's Encrypt renewal warnings. Caddy uses HTTP-01
	# by default; ports 80 + 443 must be publicly reachable.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	reverse_proxy cmdb:4321 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
